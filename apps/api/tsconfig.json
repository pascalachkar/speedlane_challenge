{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "languageOptions": {
    "ecmaVersion": 2022,
    "globals": {
      "browser": true
    },
    "parserOptions": {
      "tsconfigRootDir": "import.meta.dirname"
    }
  }
}
